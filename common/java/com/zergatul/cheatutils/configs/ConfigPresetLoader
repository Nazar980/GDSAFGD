import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;

public class ConfigPresetLoader {

    // ← путь до cheatutils.json
    public static Path getConfigPath() {
        return Path.of("config", "cheatutils.json");
    }

    public static void applyPreset() {
        try {
            Path path = getConfigPath();
            Files.createDirectories(path.getParent());
            Files.writeString(path, PRESET_JSON);
            System.out.println("[CheatUtils] Preset config applied.");
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

