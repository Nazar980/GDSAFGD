package com.zergatul.cheatutils;

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;

public class ConfigPresetLoader {

    // Путь до cheatutils.json
    public static Path getConfigPath() {
        return Path.of("config", "cheatutils.json");
    }

    // Метод для применения preset
    public static void applyPreset() {
        Path path = getConfigPath();

        try {
            // Создаем директорию, если ее нет
            Files.createDirectories(path.getParent());

            // Создаем файл, если его нет
            if (!Files.exists(path)) {
                Files.createFile(path);
                System.out.println("[CheatUtils] cheatutils.json created.");
            }

            // Записываем preset в файл (перезаписывает содержимое)
            Files.writeString(path, PRESET_JSON);
            System.out.println("[CheatUtils] Preset config applied.");

        } catch (IOException e) {
            System.err.println("[CheatUtils] Failed to apply preset!");
            e.printStackTrace();
        }
    }

